# CodeSphere API — environment template
# Copy to `.env` and adjust values. Never commit `.env`.

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Comma-separated browser origins allowed for CORS.
# Defaults to Vite dev URLs if omitted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging: fatal | error | warn | info | debug | trace | silent
# Defaults to `debug` in development and `info` in production.
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=code_sphere
# Tests use a separate database named `code_sphere_test` on the same instance.

# Rate limiting (global, per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=30

# Auth — replace secrets before any non-local deploy
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Frontend origin used in email verification links
FRONTEND_URL=http://localhost:5173

# Email: `console` logs the verification link (default in development).
# `smtp` sends real email (default in production) and requires SMTP_* below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CodeSphere <noreply@localhost>

# HTTP seed/clear (`POST /api/dev/seed`, `/api/dev/seed/clear`). Off unless `true`.
# Always disabled when NODE_ENV=production, even if this is true.
# Staging: leave false/unset. Local: set true to allow wipe/reseed from HTTP.
ENABLE_SEED=false

# Media uploads. `local` writes under MEDIA_UPLOAD_DIR (gitignored). S3 keys are
# optional until a bucket exists — the S3 driver throws if selected without them.
MEDIA_DRIVER=local
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_BYTES=10485760
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Trust X-Forwarded-For from a reverse proxy (throttling + auth audit `ip`).
# Local default is off so the app does not trust arbitrary forwarded headers.
TRUST_PROXY=false

